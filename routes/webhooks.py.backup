from datetime import datetime
from fastapi import APIRouter, Depends, Header, HTTPException, Request
from sqlalchemy.orm import Session

from config import SHOPIFY_WEBHOOK_SECRET
from database import get_db
from schemas.shopify_order import ShopifyOrderPaid
from services.shopify_webhooks import (
    process_paid_order,
    get_order_delivery_details,
    calculate_delivery_details,
)
from shopify_admin import set_order_delivery_details
from services.webhook_security import verify_shopify_webhook
from repositories.webhook_repository import register_delivery


router = APIRouter(
    prefix="/webhooks",
    tags=["Shopify Webhooks"],
)


@router.post("/orders-paid")
async def orders_paid(
    request: Request,
    db: Session = Depends(get_db),
    x_shopify_hmac_sha256: str | None = Header(
        default=None,
        alias="X-Shopify-Hmac-Sha256",
    ),
    x_shopify_event_id: str | None = Header(
        default=None,
        alias="X-Shopify-Event-Id",
    ),
):
    print(
        "ROUTE DEBUG:",
        "hmac=", repr(x_shopify_hmac_sha256),
        "event_id=", repr(x_shopify_event_id),
        flush=True,
    )
    
    if not SHOPIFY_WEBHOOK_SECRET:
        raise HTTPException(
            status_code=500,
            detail="Shopify webhook secret is not configured.",
        )

    # ---------------------------------------------------------
    # 1. Read the RAW request body.
    # Shopify signs this exact byte sequence.
    # ---------------------------------------------------------
    body = await request.body()


    print(
        "WEBHOOK DEBUG:",
        "HMAC header present =", bool(x_shopify_hmac_sha256),
        "HMAC header length =", len(x_shopify_hmac_sha256 or ""),
        "body length =", len(body),
        flush=True,
    )
    
    # ---------------------------------------------------------
    # 2. Require Shopify HMAC.
    # ---------------------------------------------------------
    if not x_shopify_hmac_sha256:
        raise HTTPException(
            status_code=401,
            detail="Missing Shopify webhook signature.",
        )

    # ---------------------------------------------------------
    # 3. Verify HMAC BEFORE parsing or processing anything.
    # ---------------------------------------------------------
    if not verify_shopify_webhook(
        secret=SHOPIFY_WEBHOOK_SECRET,
        body=body,
        hmac_header=x_shopify_hmac_sha256,
    ):
        raise HTTPException(
            status_code=401,
            detail="Invalid Shopify webhook signature.",
        )

    # ---------------------------------------------------------
    # 4. Require Shopify delivery/event ID.
    # ---------------------------------------------------------
    if not x_shopify_event_id:
        raise HTTPException(
            status_code=400,
            detail="Missing Shopify webhook event ID.",
        )

    # ---------------------------------------------------------
    # 5. Register the delivery AFTER HMAC verification.
    #
    # The database unique constraint prevents the same
    # Shopify delivery from being processed twice.
    # ---------------------------------------------------------
    delivery = register_delivery(
        db=db,
        event_id=x_shopify_event_id,
        topic="orders/paid",
    )

    if delivery is None:
        return {
            "status": "duplicate",
            "message": "Shopify webhook delivery already processed.",
        }

    # ---------------------------------------------------------
    # 6. Only parse the JSON after HMAC verification.
    # ---------------------------------------------------------
    order = ShopifyOrderPaid.model_validate_json(body)

    # ---------------------------------------------------------
    # 7. Process the verified Shopify order.
    #
    # process_paid_order() -> award_seeds()
    # award_seeds() commits the transaction.
    # ---------------------------------------------------------
    result = process_paid_order(
        db=db,
        order=order,
    )

    # ---------------------------------------------------------
    # Calculate delivery details for this order
    # ---------------------------------------------------------
    delivery = get_order_delivery_details(order)

    # ---------------------------------------------------------
    # Save delivery details to Shopify order
    # ---------------------------------------------------------
    set_order_delivery_details(
        order_id=order.id,
        delivery_date=delivery["delivery_date"],
        delivery_day=delivery["delivery_day"],
        delivery_time=delivery["delivery_time"],
    )

    db.commit()

    return {
        **result,
        "delivery_date": str(delivery["delivery_date"]),
        "delivery_day": delivery["delivery_day"],
        "delivery_time": delivery["delivery_time"],
    }
    
@router.post("/orders-created")
async def orders_created(request: Request):
    try:
        body = await request.json()

        order_id = body.get("id")
        created_at = body.get("created_at")

        print(
            "SHOPIFY ORDER CREATED:",
            {
                "order_id": order_id,
                "created_at": created_at,
                "source_name": body.get("source_name"),
            },
            flush=True,
        )

        if not order_id:
            return {
                "status": "ignored",
                "reason": "missing_order_id",
            }

        if not created_at:
            return {
                "status": "ignored",
                "reason": "missing_created_at",
                "order_id": order_id,
            }

        created_at_dt = datetime.fromisoformat(
            created_at.replace("Z", "+00:00")
        )

        delivery_options = calculate_delivery_details(created_at_dt)

        if body.get("shipping_address"):
            delivery = delivery_options["home"]
        else:
            delivery = delivery_options["pickup"]

        set_order_delivery_details(
            order_id=order_id,
            delivery_date=delivery["delivery_date"],
            delivery_day=delivery["delivery_day"],
            delivery_time=delivery["delivery_time"],
        )

        print(
            "DELIVERY METAFIELDS UPDATED:",
            {
                "order_id": order_id,
                "delivery_date": str(delivery["delivery_date"]),
                "delivery_day": delivery["delivery_day"],
                "delivery_time": delivery["delivery_time"],
            },
            flush=True,
        )

        return {
            "status": "success",
            "order_id": order_id,
            "delivery_date": str(delivery["delivery_date"]),
            "delivery_day": delivery["delivery_day"],
            "delivery_time": delivery["delivery_time"],
        }

    except Exception as exc:
        import traceback
        traceback.print_exc()

        return {
            "status": "error",
            "error": str(exc),
            "error_type": type(exc).__name__,
        }
         
@router.post("/recharge-charge-paid")
async def recharge_charge_paid(request: Request):
    try:
        body = await request.json()

        charge_id = body.get("id")
        charge_type = body.get("type")
        charge_status = body.get("status")

        print(
            "RECHARGE CHARGE PAID:",
            {
                "id": charge_id,
                "type": charge_type,
                "status": charge_status,
                "created_at": body.get("created_at"),
                "external_order_id": body.get("external_order_id"),
            },
            flush=True,
        )

        if str(charge_type).lower() != "recurring":
            return {
                "status": "ignored",
                "reason": "not_recurring",
                "charge_id": charge_id,
            }

        if str(charge_status).lower() != "success":
            return {
                "status": "ignored",
                "reason": "charge_not_successful",
                "charge_id": charge_id,
            }

        external_order_id = body.get("external_order_id") or {}
        shopify_order_id = external_order_id.get("ecommerce")

        if not shopify_order_id:
            return {
                "status": "ignored",
                "reason": "missing_shopify_order_id",
                "charge_id": charge_id,
            }

        try:
            shopify_order_id = int(shopify_order_id)
        except (TypeError, ValueError):
            return {
                "status": "ignored",
                "reason": "invalid_shopify_order_id",
                "charge_id": charge_id,
                "external_order_id": external_order_id,
            }

        created_at = body.get("created_at")
        
        print(
            "RECHARGE DELIVERY UPDATE:",
            {
                "charge_id": charge_id,
                "shopify_order_id": shopify_order_id,
                "created_at": created_at,
                "has_shipping_address": bool(body.get("shipping_address")),
            },
            flush=True,
        )

        if not created_at:
            raise HTTPException(
                status_code=400,
                detail="Recharge charge is missing created_at",
            )

        created_at_dt = datetime.fromisoformat(
            created_at.replace("Z", "+00:00")
        )

        delivery_options = calculate_delivery_details(created_at_dt)

        if body.get("shipping_address"):
            delivery = delivery_options["home"]
        else:
            delivery = delivery_options["pickup"]

        set_order_delivery_details(
            order_id=shopify_order_id,
            delivery_date=delivery["delivery_date"],
            delivery_day=delivery["delivery_day"],
            delivery_time=delivery["delivery_time"],
        )

        return {
            "status": "success",
            "charge_id": charge_id,
            "shopify_order_id": shopify_order_id,
            "delivery_date": str(delivery["delivery_date"]),
            "delivery_day": delivery["delivery_day"],
            "delivery_time": delivery["delivery_time"],
        }

    except HTTPException:
        raise

    except Exception as exc:
        import traceback

        traceback.print_exc()

        return {
            "status": "error",
            "error": str(exc),
            "error_type": type(exc).__name__,
        }